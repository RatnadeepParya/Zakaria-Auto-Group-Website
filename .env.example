# Environment Mode
NODE_ENV=development

# Server Ports & Origins
PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://zakaria_user:zakaria_secure_pass_2026@localhost:5432/zakaria_auto_group?schema=public

# Security & Authentication (minimum 32 characters)
JWT_SECRET=super_secret_jwt_key_must_be_at_least_32_characters_long_for_security!
COOKIE_SECRET=super_secret_cookie_key_for_signing_sessions_must_be_strong!
COOKIE_NAME=zakaria_session
COOKIE_SECURE=false

# Field-level Encryption (32-byte hex for AES-256-GCM encryption of sensitive credit PII)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Default Seed Administrator
SEED_ADMIN_EMAIL=admin@zakariaautogroup.com
SEED_ADMIN_PASSWORD=AdminZakaria2026!
